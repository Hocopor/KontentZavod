# Скопируйте этот файл в .env и заполните значения
DEEPSEEK_API_KEY=your_deepseek_api_key_here
FERNET_KEY=generate_with_python_-c_"from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())"
LLM_ROUTER_BASE_URL=http://127.0.0.1:8100/v1
LLM_ROUTER_KEY=your_virtual_key_here
FAKE_LLM=0
PUBLISH_DRY_RUN=1
ENABLE_SCHEDULER=0
DB_PATH=data/kontentzavod.db
DATA_DIR=data
# Видеоконвейер (этап 3)
FAKE_TTS=0
FAKE_ASSETS=0
PEXELS_API_KEY=
PIXABAY_API_KEY=
MEDIA_RETENTION_DAYS=14
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# YouTube Data API: 10 000 юнитов/день, videos.insert = 1600 юнитов → ~6 загрузок
YOUTUBE_DAILY_LIMIT=6
# Pollinations.ai токен (опционально): бесплатная регистрация на pollinations.ai
# Снимает анонимный лимит 402 по IP — рекомендуется для продового сервера
POLLINATIONS_TOKEN=
